import tkinter as tk
from tkinter import messagebox
import json
import os

# File to store contacts
FILE_NAME = "contacts.json"

# List to store contacts
contacts = []

# ---------------- FILE HANDLING ---------------- #

# Load contacts from file
def load_contacts():
    global contacts

    if os.path.exists(FILE_NAME):
        with open(FILE_NAME, "r") as file:
            try:
                contacts = json.load(file)

                for contact in contacts:
                    contact_text = f"{contact['name']} | {contact['phone']} | {contact['email']}"
                    listbox.insert(tk.END, contact_text)

            except json.JSONDecodeError:
                contacts = []

# Save contacts to file
def save_contacts():
    with open(FILE_NAME, "w") as file:
        json.dump(contacts, file, indent=4)

# ---------------- CONTACT FUNCTIONS ---------------- #

# Function to add contact
def add_contact():
    name = entry_name.get()
    phone = entry_phone.get()
    email = entry_email.get()

    if name == "" or phone == "" or email == "":
        messagebox.showwarning("Input Error", "All fields are required!")
        return

    contact = {
        "name": name,
        "phone": phone,
        "email": email
    }

    contacts.append(contact)

    listbox.insert(tk.END, f"{name} | {phone} | {email}")

    save_contacts()
    clear_fields()

# Function to clear input fields
def clear_fields():
    entry_name.delete(0, tk.END)
    entry_phone.delete(0, tk.END)
    entry_email.delete(0, tk.END)

# Function to delete contact
def delete_contact():
    try:
        selected_index = listbox.curselection()[0]

        listbox.delete(selected_index)
        contacts.pop(selected_index)

        save_contacts()

    except:
        messagebox.showwarning("Selection Error", "No contact selected!")

# Function to select contact
def select_contact(event):
    try:
        selected_index = listbox.curselection()[0]

        selected_contact = contacts[selected_index]

        entry_name.delete(0, tk.END)
        entry_name.insert(tk.END, selected_contact["name"])

        entry_phone.delete(0, tk.END)
        entry_phone.insert(tk.END, selected_contact["phone"])

        entry_email.delete(0, tk.END)
        entry_email.insert(tk.END, selected_contact["email"])

    except:
        pass

# Function to update contact
def update_contact():
    try:
        selected_index = listbox.curselection()[0]

        name = entry_name.get()
        phone = entry_phone.get()
        email = entry_email.get()

        if name == "" or phone == "" or email == "":
            messagebox.showwarning("Input Error", "All fields are required!")
            return

        updated_contact = {
            "name": name,
            "phone": phone,
            "email": email
        }

        contacts[selected_index] = updated_contact

        listbox.delete(selected_index)
        listbox.insert(selected_index, f"{name} | {phone} | {email}")

        save_contacts()
        clear_fields()

    except:
        messagebox.showwarning("Selection Error", "No contact selected!")

# ---------------- GUI WINDOW ---------------- #

root = tk.Tk()
root.title("Contact Manager")
root.geometry("400x400")

# Labels and Entries
tk.Label(root, text="Name").pack()

entry_name = tk.Entry(root)
entry_name.pack()

tk.Label(root, text="Phone").pack()

entry_phone = tk.Entry(root)
entry_phone.pack()

tk.Label(root, text="Email").pack()

entry_email = tk.Entry(root)
entry_email.pack()

# Buttons
tk.Button(root, text="Add Contact", command=add_contact).pack(pady=5)

tk.Button(root, text="Update Contact", command=update_contact).pack(pady=5)

tk.Button(root, text="Delete Contact", command=delete_contact).pack(pady=5)

tk.Button(root, text="Clear Fields", command=clear_fields).pack(pady=5)

# Listbox
listbox = tk.Listbox(root)
listbox.pack(fill=tk.BOTH, expand=True)

listbox.bind('<<ListboxSelect>>', select_contact)

# Load saved contacts when app starts
load_contacts()

# Run app
root.mainloop()